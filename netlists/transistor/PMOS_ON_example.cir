* 32nm_LP single PMOS - case PMOS_ON - sample 0
* VDD=0.942886 V, T=96.1283 C, W=2.530189e-07 m
.param p_n_vth0=0.63 p_n_toxe=1.6e-09 p_n_ndep=4.12e+18 p_n_u0=0.042 p_n_xj=5e-08
.param p_p_vth0=-0.6168663514 p_p_toxe=1.701143564e-09 p_p_ndep=2.835995978e+18 p_p_u0=0.01532227914 p_p_xj=9.115115051e-09
.include "32nm_LP_param.lib"
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.temp 96.128309

M1 drain gate source body pmos W=2.530189e-07 L=3.200e-08
Vd drain 0 dc 0.430786202
Vg gate 0 dc 0.000000000
Vs source 0 dc 0.030560842
Vb body 0 dc 0.942886484

.control
set numdgt=12
op
* terminal currents INTO the device = -I(source)
let id = -i(vd)
let ig = -i(vg)
let is = -i(vs)
let ib = -i(vb)
print id ig is ib
echo Kirchhoff check (id+ig+is+ib):
print id+ig+is+ib
.endc
.end
