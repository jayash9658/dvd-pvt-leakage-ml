* 32nm_LP single NMOS - case NMOS_ON - sample 0
* VDD=1.088707 V, T=25.8725 C, W=2.074798e-07 m
.param p_n_vth0=0.5816843596 p_n_toxe=1.58197166e-09 p_n_ndep=4.017970196e+18 p_n_u0=0.04328728873 p_n_xj=4.837242959e-08
.param p_p_vth0=-0.5808 p_p_toxe=1.62e-09 p_p_ndep=3.07e+18 p_p_u0=0.016 p_p_xj=1e-08
.include "32nm_LP_param.lib"
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.temp 25.872488

M1 drain gate source body nmos W=2.074798e-07 L=3.200e-08
Vd drain 0 dc 0.889227749006
Vg gate 0 dc 1.088706501122
Vs source 0 dc 1.088706501122
Vb body 0 dc 0.000000000000

.control
set numdgt=12
op
* terminal currents INTO the device = -I(source)
let id = -i(vd)
let ig = -i(vg)
let is = -i(vs)
let ib = -i(vb)
print id ig is ib
echo Kirchhoff check (id+ig+is+ib):
print id+ig+is+ib
.endc
.end
